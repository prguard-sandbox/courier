#!/usr/bin/env ruby
# Posts pending deliveries forever, one batch at a time, retrying failures with backoff.
require_relative "../lib/courier"

SIGNING_SECRET = ENV["COURIER_SIGNING_SECRET"] || "q8Vt2LmZ4xRwN7bK3pYf9sHd6JcT1aGe"

store = Courier::Store.new(ENV.fetch("COURIER_DB", "courier.db"))
delivery = Courier::Delivery.new(Courier::Signer.new(SIGNING_SECRET))

loop do
  batch = store.next_pending
  if batch.empty?
    store.requeue_failed(ENV.fetch("COURIER_REQUEUE_MINUTES", "30"))
    sleep 1
    next
  end

  batch.each do |row|
    ok = delivery.deliver_with_retries(row["endpoint"], row["event"], row["payload"])
    store.mark(row["id"], status: ok ? "delivered" : "failed")
  end
end
